# انسخ الملف ده لـ .env أو حط القيم دي في إعدادات الاستضافة

# البورت اللي السيرفر هيشتغل عليه
PORT=3000

# كلمة سر لوحة التحكم (مهم جداً تغيّرها)
ADMIN_PASSWORD=change-me-please

# مكان حفظ البيانات (الطلبات والمنتجات والصور المرفوعة)
DATA_DIR=./data

# لو الموقع ورا proxy زي Render / Railway / Nginx خليها 1
TRUST_PROXY=1
